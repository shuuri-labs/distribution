# Mark SDAM byte 0 = 0xFF (kernel PM path and all post-resume hooks completed).
printf '\xFF' | dd of=/sys/bus/nvmem/devices/spmi_sdam0/nvmem \
    bs=1 count=1 seek=0 conv=notrunc 2>/dev/null || true
