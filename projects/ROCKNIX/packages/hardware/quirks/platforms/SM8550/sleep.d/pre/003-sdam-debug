# Mark SDAM byte 0x50 = 0x01 (entered suspend, kernel PM path not yet started).
# If byte 0x50 is 0x01 on next boot, the failure was inside the kernel PM path.
# If byte 0x50 is 0xFF, suspend/resume completed fully before the failure.
# Offset 0x50 is within the 0x50-0x7f window confirmed free for scratch use on
# spmi_sdam0 (offset 0 is out of bounds for this device and always fails).
printf '\x01' | dd of=/sys/bus/nvmem/devices/spmi_sdam0/nvmem \
    bs=1 count=1 seek=80 conv=notrunc 2>/dev/kmsg || echo "003-sdam-debug: SDAM write failed" >/dev/kmsg
