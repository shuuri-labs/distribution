# Mark SDAM byte 0 = 0x01 (entered suspend, kernel PM path not yet started).
# If byte 0 is 0x01 on next boot, the failure was inside the kernel PM path.
# If byte 0 is 0xFF, suspend/resume completed fully before the failure.
printf '\x01' | dd of=/sys/bus/nvmem/devices/spmi_sdam0/nvmem \
    bs=1 count=1 seek=0 conv=notrunc 2>/dev/null || true
